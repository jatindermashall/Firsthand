# Production values live in the Docker Manager project environment on the VPS, not in git.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 16+ random characters. Unlocks /admin for 12 hours per session.
ADMIN_ACCESS_KEY=
# Optional. When set, sign-in codes are emailed and the on-screen "preview code" turns off.
# e.g. smtps://user:password@smtp.hostinger.com:465
SMTP_URL=
MAIL_FROM=Firsthand <no-reply@firsthand.decyb.com>
# Set to false once real businesses are onboarded (sample data only loads into an empty database).
SEED_DEMO=true
